# Copy to `.env` in this directory and fill in values before running setup/training.
#   cp .env.example .env
#
# The setup script sources `.env` automatically:
#   bash scripts/setup_remote_training.sh

# --- GPUs / devices (Stage 2) -------------------------------------------------
# Comma-separated GPU indices (unset = all GPUs reported by nvidia-smi)
CUDA_VISIBLE_DEVICES=0,1
# Primary device for Whisper/adapter: cuda (default), cpu, or cuda:N
DEVICE=cuda
# Optional separate GPU for frozen Qwen (e.g. DEVICE=cpu + LLM_DEVICE=cuda:1)
# LLM_DEVICE=cuda:1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Per-GPU Qwen weight budget when 2+ GPUs visible (logical indices after CUDA_VISIBLE_DEVICES).
# Fills GPU 0 first (sequential), spills overflow to GPU 1. Unset = balanced auto-shard.
# Example: GPU 0 full for Whisper+Qwen, GPU 1 capped at 5GiB for spill + other processes.
# LLM_MAX_MEMORY=0:14GiB,1:5GiB

# Exclusive GPU locks: hold visible GPUs until process exit; other training/eval scripts block.
# adapter_asr_only_trainer.py sets GPU_LOCK=true by default. Set off to disable.
# GPU_LOCK=true
# GPU_LOCK_DIR=.gpu_locks
# Soft VRAM fence (PyTorch): hold free CUDA memory between train steps so other
# processes cannot steal the post-step dip. Not a true NVIDIA exclusive lock.
# CUDA_MEM_FENCE=true
# CUDA_MEM_LEAVE_FREE_GB=1.5

# --- PyTorch install (setup script + optional trainer check) --------------------
TORCH_VERSION=2.11.0
# Leave empty for auto-detect; set e.g. cu124 if auto-detect picks the wrong wheel
TORCH_CUDA_INDEX=
# Comma-separated fallbacks tried when CUDA smoke test fails
TORCH_COMPAT_RETRY_INDEXES=cu128,cu126,cu124,cu118
# Set 1 to re-check/reinstall torch at trainer startup (setup script always checks)
CHECK_TORCH_COMPAT=0
SKIP_TORCH_COMPAT=0

# --- Training launcher ----------------------------------------------------------
# auto = torchrun when 2+ GPUs visible, else uv run
USE_TORCHRUN=auto
# Stage 2 shards the frozen LLM across GPUs in one process; keep 1 for Qwen3-8B on 2x16GB
TORCHRUN_NPROC_PER_NODE=1
TORCHRUN_MASTER_PORT=29500

# --- Paths --------------------------------------------------------------------
# Unset = train-clean-100 + train-clean-360 under datasets/librispeech_data/LibriSpeech/
# Override with one path or comma-separated list
DATASET_ROOT=
CHECKPOINT_DIR=checkpoints
# Resume from a specific file (unset = checkpoints/<CHECKPOINT_BASENAME>.pt when present)
RESUME_CHECKPOINT=
# Stage 2: save adapter_stage2.pt + adapter_stage2_step{N}.pt every N training steps (unset = off)
SAVE_EVERY_STEPS=200
# Warm-start adapter weights for Stage 2 / Vicuna ASR+align (required when LOAD_STAGE1_CHECKPOINT=true)
STAGE1_CHECKPOINT=checkpoints/adapter_stage1.pt
# Custom checkpoint basename (default adapter_stage2); also used by gate_training.py
# CHECKPOINT_BASENAME=adapter_stage2
# ASR ablation: skip Stage 1 init, gate training, load pretrained gate
# LOAD_STAGE1_CHECKPOINT=true
# TRAIN_GATE=true
# GATE_CHECKPOINT=checkpoints/gate_smart_turn.pt
# Frozen adapter for gate_training.py (default: adapter_stage1.pt)
# ADAPTER_CHECKPOINT=checkpoints/adapter_stage1.pt
# Gate training epochs in run_experiment_suite.sh (default 5)
# GATE_EPOCHS=5
# Hub repo for Stage 1 download and Stage 2 epoch uploads (repo root)
HF_CHECKPOINT_REPO=vaghawan/audio-streaming-adapter-checkpoints
HF_CHECKPOINT_REVISION=main
# Upload adapter_stage{N}_epoch{M}.pt after each epoch (additive; other repo files unchanged)
HF_UPLOAD_CHECKPOINTS=false
HF_CHECKPOINT_PRIVATE=false

# --- Data / optimization ------------------------------------------------------
BATCH_SIZE=16
# Stage 2 / ASR: gradient accumulation. Effective update batch = MACRO_BATCH_SIZE
# when set (must be a multiple of BATCH_SIZE). Unset = no accumulation.
# Vicuna ASR+align defaults: BATCH_SIZE=16 (micro), MACRO_BATCH_SIZE=128 (effective).
# Example: BATCH_SIZE=2 and MACRO_BATCH_SIZE=16 -> 8 accumulation steps.
#
# Stage 1 softmax InfoNCE (adapter_contrastive_trainer_softmax.py): MACRO_BATCH_SIZE
# is the true InfoNCE batch via GradCache (default 128); BATCH_SIZE is the encode
# micro-batch (default 8 if unset in that trainer). Softmax defaults when unset:
# LAMBDA_STABILITY=0.01, grad_clip_norm=2.0 (so Align can move early). GradCache
# uses adapter.eval() on cache+recompute so dropout does not break the surrogate.
# Example:
#   BATCH_SIZE=8
#   MACRO_BATCH_SIZE=128
#   RANDOM_SEED=42
# 2-GPU data parallel:
#   uv run torchrun --standalone --nnodes=1 --nproc_per_node=2 \
#     training/adapter_contrastive_trainer_softmax.py
MACRO_BATCH_SIZE=128
RANDOM_SEED=42
NUM_WORKERS=2
MAX_WINDOWS_PER_UTT=8
EPOCHS=10
LEARNING_RATE=5e-5
WEIGHT_DECAY=0.01
GRAD_CLIP_NORM=1.0
WARMUP_STEPS=1000

# --- Stage 2 loss weights -----------------------------------------------------
LAMBDA_ALIGN=0.1
LAMBDA_STABILITY=0.05
LAMBDA_RATE=0.001
LAMBDA_GATE=0.1
TEMPERATURE=0.07
USE_RATE_CONTROLLER=true
RATE_TARGET=2.0
MAX_TEXT_TOKENS=128
ASR_MICRO_BATCH_SIZE=16
# Recommended on multi-GPU to reduce LLM activation memory
ENABLE_LLM_GRADIENT_CHECKPOINTING=true

# --- Stage 2 validation (dev-clean, same split as Stage 1) ------------------
VAL_ENABLED=true
VAL_EVERY_STEPS=1000
# Cap dev-clean utterances per validation run (all | none | unlimited = full split)
VAL_MAX_UTTERANCES=all
# Decode settings for validation WER/BLEU (full dev-clean decode is slow)
# VAL_MAX_NEW_TOKENS=496
# VAL_NUM_BEAMS=1
# VAL_REPETITION_PENALTY=1.25
# VAL_LOG_EVERY=50

# --- Model IDs ----------------------------------------------------------------
WHISPER_MODEL_ID=openai/whisper-small
LLM_MODEL_ID=Qwen/Qwen3-8B
# Vicuna ASR+align (training/adapter_asr_align_vicuna_trainer.py); does not override LLM_MODEL_ID
VICUNA_MODEL_ID=lmsys/vicuna-7b-v1.5

# --- Weights & Biases ---------------------------------------------------------
WANDB_ENABLED=true
WANDB_API_KEY=
WANDB_PROJECT=audio-streaming-adapter
WANDB_ENTITY=
WANDB_RUN_NAME=stage2-asr

# --- Evaluation (retrieval cosine) --------------------------------------------
RETRIEVAL_NUM_UTTERANCES=2620

# --- Evaluation (NLL retrieval) -----------------------------------------------
# Used by evaluation/eval_stage1.py / eval_stage2.py --metric retrieval-nll
RETRIEVAL_NLL_NUM_UTTERANCES=100
RETRIEVAL_NLL_BATCH_SIZE=2

# --- Evaluation (ASR WER / BLEU on test-clean) --------------------------------
# Used by evaluation/eval_stage1.py / eval_stage2.py --metric asr
ASR_EVAL_NUM_SAMPLES=100

# --- Hugging Face -------------------------------------------------------------
# Official hub (override broken pip mirrors injected via site-packages/hf_config.pth)
HF_ENDPOINT=https://huggingface.co
HF_HOME=/workspace/.hf_home
HF_TOKEN=

# --- Logging ------------------------------------------------------------------
TRANSFORMERS_VERBOSITY=info
TOKENIZERS_PARALLELISM=false

# --- Setup script toggles -----------------------------------------------------
PYENV_VERSION=3.12
SKIP_PYENV=0
SKIP_UV_SYNC=0
SKIP_DATASET=0
SKIP_CHECKPOINT=0
SKIP_MODEL_PREFETCH=0
SKIP_TRAINING=0
